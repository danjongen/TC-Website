---
import { Picture, getImage } from 'astro:assets'
import '../styles/global.css'

// PLACEHOLDER: swap this file for the real show photo (same filename, or
// update the import). Astro regenerates the AVIF/WebP variants on build.
import heroShow from '../assets/hero-show.jpg'

// NOTE: the store was still password-protected when this was wired up, so
// the link dead-ends at the password page until the store is launched
// (Shopify admin: Online Store -> Preferences -> remove password).
const SHOPIFY_BUY_URL =
  'https://technically-creative-supply-86j6j.myshopify.com/products/ssl-console-shelf'

const PRICE = '$89'

const base = import.meta.env.BASE_URL // '/sslshelf'

// Headline options, all short and confident. Swap by editing the <h1> below.
//   A (live): Somewhere to put it. Finally.
//   B:        Your console was missing a shelf.
//   C:        The shelf your console shipped without.
const headline = 'Somewhere to put it. Finally.'

const description =
  'A shelf that clips onto the SSL Live top rail in seconds. Holds your timecode, phone, coffee and notes at FOH. No tools, no drilling, no gaffer tape. $89.'

const heroAlt =
  'The TC SSL Shelf clipped onto the top rail of an SSL Live console at front of house, holding a timecode unit.'

// OG image is derived from the hero at build time, so it updates
// automatically when the real show photo lands.
const ogImage = await getImage({
  src: heroShow,
  width: 1200,
  height: 630,
  fit: 'cover',
  format: 'jpeg',
})
const canonical = new URL(base, Astro.site).href
const ogImageUrl = new URL(ogImage.src, Astro.site).href

const productJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'TC SSL Shelf',
  description,
  image: [ogImageUrl],
  brand: { '@type': 'Brand', name: 'TC' },
  offers: {
    '@type': 'Offer',
    price: '89',
    // Assumption: AUD. Change here if the Shopify listing is in another currency.
    priceCurrency: 'AUD',
    availability: 'https://schema.org/InStock',
    url: canonical,
  },
})
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>TC SSL Shelf | Somewhere to put it</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0a0a0a" />
    <!-- Icon comes from the main tc.agency site at the domain root. -->
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />

    <meta property="og:type" content="product" />
    <meta property="og:site_name" content="TC" />
    <meta property="og:title" content="TC SSL Shelf" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    <link
      rel="preload"
      href={`${base}/fonts/space-mono-latin-700-normal.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={`${base}/fonts/space-mono-latin-400-normal.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={`${base}/fonts/inter-latin-wght-normal.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <script type="application/ld+json" set:html={productJsonLd} />
  </head>

  <body class="bg-ink font-sans text-paper antialiased">
    <main>
      <!-- HERO: the show photo is the centerpiece and the proof. It is the
           LCP element, so it loads eagerly with high priority; everything
           below the fold is lazy instead. -->
      <section class="relative" aria-label="TC SSL Shelf">
        <div class="relative min-h-[92svh]">
          <Picture
            src={heroShow}
            widths={[768, 1280, 1920, 2400]}
            sizes="100vw"
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            loading="eager"
            fetchpriority="high"
            alt={heroAlt}
            class="absolute inset-0 h-full w-full object-cover"
          />
          <!-- Scrim keeps the overlaid text at AA contrast on any photo. -->
          <div
            class="absolute inset-0 bg-linear-to-t from-ink via-ink/40 to-ink/10"
            aria-hidden="true"
          >
          </div>
          <div
            class="relative mx-auto flex min-h-[92svh] w-full max-w-6xl flex-col justify-end px-6 pb-16 md:pb-24"
          >
            <p class="font-mono text-sm tracking-[0.35em] text-accent">
              TC SSL SHELF
            </p>
            <h1
              class="mt-4 max-w-[16ch] font-mono text-[clamp(2.2rem,6.5vw,4.75rem)] leading-[1.08] font-bold text-balance"
            >
              {headline}
            </h1>
          </div>
        </div>
      </section>

      <!-- THE ONE BENEFIT LINE -->
      <section class="mx-auto w-full max-w-6xl px-6 py-16 md:py-24">
        <p class="max-w-[46ch] text-xl leading-relaxed text-paper/90 md:text-2xl">
          Clips onto the SSL Live top rail in seconds. Holds your timecode,
          phone, coffee and notes. No tools, no drilling, no gaffer tape.
        </p>
      </section>

      <!-- BUY: one clear action. -->
      <section
        class="mx-auto flex w-full max-w-6xl flex-col items-center border-t border-paper/10 px-6 py-20 text-center md:py-28"
        aria-labelledby="buy-heading"
      >
        <h2 id="buy-heading" class="sr-only">Buy the TC SSL Shelf</h2>
        <p class="font-mono text-5xl font-bold md:text-6xl">
          <span class="sr-only">Price:</span>{PRICE}
        </p>
        <a
          href={SHOPIFY_BUY_URL}
          class="buy-button mt-8 inline-block bg-accent px-12 py-5 font-mono text-lg font-bold tracking-[0.2em] text-ink uppercase transition-transform hover:scale-[1.02] motion-reduce:transition-none motion-reduce:hover:scale-100"
        >
          Buy the shelf
        </a>
        <p class="mt-6 font-sans text-sm text-paper/60">
          Ships ready to clip straight on.
        </p>
      </section>
    </main>

    <footer class="border-t border-paper/10">
      <div
        class="mx-auto flex w-full max-w-6xl items-center justify-between px-6 py-10"
      >
        <span class="font-mono text-xl font-bold tracking-[0.3em]">TC</span>
        <a
          href="https://tc.agency"
          class="font-mono text-sm text-paper/60 hover:text-paper"
        >
          tc.agency
        </a>
      </div>
    </footer>
  </body>
</html>
