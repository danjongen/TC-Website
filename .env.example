# TC Agency Environment Variables
# Copy this file to .env.local for local development

# ============================================================================
# REQUIRED FOR PRODUCTION
# ============================================================================

# Resend (Email Service)
RESEND_API_KEY=re_...your-key...

# Cloudflare Turnstile (CAPTCHA)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Upstash Redis (Rate Limiting)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXh2ZG...your-token...

# LED Tool — password gate for /led (builder).
# Share URLs at /led/share/<token> remain public.
LED_TOOL_PASSWORD=tc-detroit

# LED Tool — Airtable backing for "Save to project".
# Personal Access Token with scopes:
#   data.records:read, data.records:write on the CRM Base.
AIRTABLE_PAT=pat...your-token...
# Optional overrides — defaults match the CRM Base IDs.
# AIRTABLE_CRM_BASE_ID=app5wcWdD13yBPnSd
# AIRTABLE_PROJECTS_TABLE_ID=tblfGISaSElAHTPoc
# AIRTABLE_DOCUMENTS_TABLE_ID=tblBKgLMIrOijCo2Y

# ============================================================================
# OPTIONAL FOR DEVELOPMENT
# ============================================================================

# In development, you can omit Turnstile and Redis:
# - Form will work without Turnstile (logs warning)
# - Rate limiting will use in-memory store (logs warning)

# For full testing, get free accounts:
# - Turnstile: https://dash.cloudflare.com/
# - Upstash: https://console.upstash.com/

# ============================================================================
# SETUP INSTRUCTIONS
# ============================================================================

# 1. Copy this file: cp .env.example .env.local
# 2. Fill in your API keys
# 3. See docs/CONTACT-FORM-SPAM-PROTECTION.md for detailed setup
